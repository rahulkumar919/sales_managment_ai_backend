# Cold-Call Companion — backend environment variables.
# Copy to `.env` (gitignored) and fill in real values.
# NEVER commit .env; NEVER log these values.

# Supabase project URL (from Supabase dashboard → Settings → API → Project URL)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase service-role key — bypasses RLS; server-side ONLY.
# (Supabase dashboard → Settings → API → Service role / secret key)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# Groq API key (console.groq.com → API Keys; shown once — save immediately)
GROQ_API_KEY=gsk_your_groq_api_key_here
# Groq model name. Check Groq's models page for current production models.
# Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# Frontend URL for CORS allow-list (no trailing slash).
# Render placeholder URL before Vercel is set up; update after first Vercel deploy.
FRONTEND_ORIGIN=http://localhost:5173

# Server port (Render provides this automatically; default 3000 for local dev)
PORT=3000
